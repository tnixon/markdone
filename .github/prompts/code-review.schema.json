{
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "areas_clean", "overall_correctness", "overall_explanation"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "body", "priority", "confidence", "path", "line_start", "line_end", "rule"],
        "properties": {
          "title": { "type": "string" },
          "body": { "type": "string" },
          "priority": { "type": "integer", "enum": [0, 1, 2, 3] },
          "confidence": { "type": "number" },
          "path": { "type": "string" },
          "line_start": { "type": "integer" },
          "line_end": { "type": "integer" },
          "rule": { "type": ["string", "null"] }
        }
      }
    },
    "areas_clean": {
      "type": "array",
      "items": { "type": "string" }
    },
    "overall_correctness": {
      "type": "string",
      "enum": ["patch is correct", "patch is incorrect"]
    },
    "overall_explanation": { "type": "string" }
  }
}
