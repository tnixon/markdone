{
  "name": "markdone",
  "version": "0.1.3",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "dev": "npm run dev -w @markdone/app",
    "build": "npm run build -w @markdone/app",
    "build:embed": "npm run build:embed -w @markdone/app",
    "build:cli": "npm run build -w @markdone/cli",
    "build:mcp": "npm run build -w @markdone/mcp",
    "build:toolkit": "npm run build -w @markdone/toolkit",
    "build:skill": "npm run build -w @markdone/skill",
    "build:obsidian": "npm run build -w @markdone/obsidian",
    "install:obsidian": "scripts/install-obsidian-plugin.sh --build",
    "preview": "npm run preview -w @markdone/app",
    "tauri": "npm run tauri -w @markdone/app",
    "tauri:dev": "npm run tauri:dev -w @markdone/app",
    "tauri:build": "npm run tauri:build -w @markdone/app",
    "test": "npm test --workspaces --if-present",
    "test:watch": "npm run test:watch -w @markdone/core",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
